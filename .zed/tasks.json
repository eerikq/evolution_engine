[
  {
    "label": "xmake :: build :: engine",
    "command": "xmake",
    "args": ["build", "evolution_engine"],
  },
  {
    "label": "xmake :: run :: editor",
    "command": "xmake",
    "args": ["run", "evolution_editor"],
  },
  {
    "label": "xmake :: build :: editor",
    "command": "xmake",
    "args": ["build", "evolution_editor"],
  },
  {
    "label": "slang :: compile shaders",
    "command": "slangc",
    "args": [
      "shaders/shader.slang",
      "-target",
      "spirv",
      "-profile",
      "spirv_1_4",
      "-emit-spirv-directly",
      "-fvk-use-entrypoint-name",
      "-entry",
      "vertMain",
      "-entry",
      "fragMain",
      "-o",
      "shaders/compiled/slang.spv",
    ],
  },
]
